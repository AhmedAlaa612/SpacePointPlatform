# Base URL of the FastAPI backend (no trailing slash)
VITE_API_URL=http://localhost:8000

# Intercom/Fin workspace App ID for the student support messenger on /learn/*.
# Public by design (it ships in the bundle) — the identity-verification secret
# is a separate, server-side value and never belongs here. Leave blank to
# disable the widget entirely: no script is loaded and no requests are made.
# Read at build time like VITE_API_URL above, so changing it needs a rebuild.
VITE_INTERCOM_APP_ID=
