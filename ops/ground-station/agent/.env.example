# Register a device first: staff calls
#   POST {API}/ground-station/admin/devices  {"label": "Lab Rig 1"}
# and copies the returned id/secret here — the secret is shown once only.
GROUND_STATION_API_BASE_URL=https://api.example.com
GROUND_STATION_DEVICE_ID=
GROUND_STATION_DEVICE_SECRET=

# Serial Port Configuration (ignored in --simulate mode)
# Windows: COM1, COM3, etc.  Linux/Mac: /dev/ttyUSB0, /dev/ttyACM0
GROUND_STATION_SERIAL_PORT=/dev/ttyUSB0
GROUND_STATION_SERIAL_BAUD=115200

GROUND_STATION_COMMAND_POLL_SECONDS=1.0
